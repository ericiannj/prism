# Database — use internal Docker network hostname
DATABASE_URL=postgresql://prism:<POSTGRES_PASSWORD>@postgres:5432/prism

# Postgres password — must match POSTGRES_PASSWORD here and in DATABASE_URL above
POSTGRES_PASSWORD=change-me-to-a-strong-random-password

# LLM + embeddings
OPENROUTER_API_KEY=

# Web search
TAVILY_API_KEY=

# Auth — must match between api and auth services
JWT_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Auth server URL — use internal Docker network hostname in production
BETTER_AUTH_URL=http://auth:3001

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web app public URL — used by api and auth for CORS (include protocol, no trailing slash)
# Example: http://ec2-12-34-56-78.compute-1.amazonaws.com
WEB_URL=http://localhost
